#!/usr/bin/env bash
# Run static analysis exactly as the CI `cppcheck` job does
# (.github/workflows/ci.yml, "Run cppcheck" step).
#
# CI is the authoritative gate: a PASS from this script does not guarantee
# the CI job passes. CI has twice flagged defects (e.g. uselessOverride in
# XtcReaderActivity.h at bd34800c) that the identical local invocation
# (same byte-identical tool-cppcheck binary, same content, same env/flags)
# did not reproduce — the divergence sits in PlatformIO's per-file analysis
# environment, not in tool versions. Always treat the CI cppcheck job as
# authoritative before pushing.
#
# Tool facts (verified 2026-10-25):
#   PlatformIO Core 6.2.0 (CI: uv pioarduino platformio-core v6.2.0 zip)
#   tool-cppcheck package 1.22200.0 (official PlatformIO registry, owner
#   "platformio") = "Cppcheck 2.22.0" on BOTH CI and local; binary has no
#   pcre linkage (only libc/libstdc++), so the CI job runs on the standard
#   ubuntu-latest image (26.x). The old pioarduino 2.20.1 binary needed
#   libpcre.so.3, which 26.x dropped (its exec failed with exit 127).
#   The tool is pinned in platformio.ini [env:cppcheck] platform_packages
#   and installed + version-synced by bin/cppcheck-tool-sync (see that
#   script for why the sync is required before any pio check).
#   The check runs in the dedicated [env:cppcheck] env (extends
#   env:default) so the analyzer sees the same defines/includes as a real
#   build while the tool pin stays out of the build envs.
set -euo pipefail

resolve_pio() {
  if [[ -n "${PIO_BIN:-}" ]]; then
    echo "${PIO_BIN}"
    return 0
  fi
  if command -v pio >/dev/null 2>&1; then
    command -v pio
    return 0
  fi
  # PlatformIO Core's own venv; PLATFORMIO_CORE_DIR relocates it.
  local penv="${PLATFORMIO_CORE_DIR:-$HOME/.platformio}/penv/bin/pio"
  if [[ -x "${penv}" ]]; then
    echo "${penv}"
    return 0
  fi
  return 1
}

if ! PIO="$(resolve_pio)"; then
  echo "cppcheck-check: 'pio' not found on PATH or at \${PLATFORMIO_CORE_DIR:-\$HOME/.platformio}/penv/bin/pio." >&2
  echo "Install PlatformIO Core or point PIO_BIN at the pio executable." >&2
  exit 127
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"${SCRIPT_DIR}/cppcheck-tool-sync"

exec "${PIO}" check -e cppcheck \
  --fail-on-defect low \
  --fail-on-defect medium \
  --fail-on-defect high